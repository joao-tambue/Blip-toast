{
  "name": "blip-toast",
  "version": "0.1.0",
  "description": "Modern Toast Notifications for React Native",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src",
    "scripts",
    "public"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "postinstall": "node scripts/postinstall.js"
  },
  "keywords": [
    "react-native",
    "toast",
    "notification",
    "snackbar",
    "alerts",
    "ui",
    "animations"
  ],
  "author": "Blip Toast Contributors",
  "license": "MIT",
  "homepage": "https://github.com/joao-tambue/Blip-toast#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/joao-tambue/Blip-toast.git",
    "directory": "packages/blip-toast"
  },
  "bugs": {
    "url": "https://github.com/joao-tambue/Blip-toast/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-svg": ">=13.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-svg": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "eslint": "^8.56.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-svg": "^15.15.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^4.1.2",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2"
  }
}
