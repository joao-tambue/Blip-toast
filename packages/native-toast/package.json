{
  "name": "native-toast",
  "version": "0.1.0",
  "description": "Modern Toast Notifications for React Native",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react-native",
    "toast",
    "notification",
    "snackbar",
    "alerts",
    "ui",
    "animations"
  ],
  "author": "Blip Toast Contributors",
  "license": "MIT",
  "homepage": "https://github.com/your-org/native-toast#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/native-toast.git",
    "directory": "packages/native-toast"
  },
  "bugs": {
    "url": "https://github.com/your-org/native-toast/issues"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "eslint": "^8.56.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
